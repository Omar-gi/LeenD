{
  "name": "leen-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx --env-file-if-exists=.env.local scripts/evaluate.ts",
    "voices": "tsx --env-file-if-exists=.env.local scripts/voices.ts",
    "audition": "tsx --env-file-if-exists=.env.local scripts/audition.ts",
    "prepare:audio": "tsx --env-file-if-exists=.env.local scripts/prepare-social-audio.ts",
    "test:ui-server": "tsx tests/ui-server.ts",
    "test:critical": "tsx --test tests/critical.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
