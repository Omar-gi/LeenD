# Copy to .env.local. Never commit this file with real values.
OPENAI_API_KEY=
# Explicitly enable only after accepting separately billed provider API usage.
ENABLE_PAID_APIS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=FZeLZd39ejvLgzR2gY0t
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional comma-separated voice IDs for the audition script (maximum three).
ELEVENLABS_AUDITION_VOICE_IDS=
# Generate a long random secret before public deployment; signs session receipts.
SESSION_SECRET=
# Exact public origin, e.g. https://leen-production.up.railway.app
APP_ORIGIN=http://localhost:3000
# Conservative per-process limits; deploy ONE Railway replica.
MAX_TURNS_PER_HOUR=120
MAX_TURNS_PER_DAY=500

# Parent page on Railway
PARENT_USERNAME=
PARENT_PASSWORD=
# SESSION_SECRET must be at least 32 characters for the hosted parent page.
